# ---- 服务 ----
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# ---- 数据存储 ----
DATA_DIR=./data
DB_FILE=./data/etf-monitor.db
# 分时快照保留天数（0 表示永久保留）
SNAPSHOT_RETENTION_DAYS=7

# ---- 采集 ----
# 常规标的的盘中轮询间隔（毫秒，最小 5000）：分钟级足够
# 核心池（国家队常买宽基）另有 1 秒通道，见下方 FAST_*
POLL_INTERVAL_MS=60000
# 监控池规模（按成交额取前 N 只 ETF）
UNIVERSE_SIZE=120
# 全市场 ETF 清单刷新间隔（毫秒）
UNIVERSE_REFRESH_MS=600000
# 日级资金流历史回填天数
HISTORY_DAYS=60
# 分时行情缓存天数（上游单次最多回带 5 个交易日）
INTRADAY_DAYS=5
# 收盘后批量回填分时的标的数量上限
INTRADAY_BACKFILL_LIMIT=20
# 上游请求超时与重试
REQUEST_TIMEOUT_MS=9000
UPSTREAM_RETRIES=2

# ---- 网络代理 ----
# 代理上网环境填写；留空则直连。Node 内置 fetch 不读代理环境变量，
# 本项目通过 CONNECT 隧道自行支持（见 server/lib/httpClient.js）。
# HTTPS_PROXY=http://127.0.0.1:7890

# ---- 告警 ----
# 同一规则同一 ETF 的告警冷却时间（秒）
ALERT_COOLDOWN_SEC=1800
# 单轮评估中，单条规则最多产生的告警数（防止首启动刷屏）
ALERT_MAX_PER_RULE_PER_CYCLE=60

# ---- 秒级通道（仅核心池）----
# 秒级采集只覆盖「国家队常买」的宽基 ETF，其余标的一律走上面的分钟级轮询。
# 数据源为腾讯批量快照（含外盘/内盘，可算主动买卖净额），不占用东财配额。
FAST_TICK_ENABLED=true
# 秒级轮询间隔（毫秒），最小 500
FAST_INTERVAL_MS=1000
# 核心池代码，逗号分隔；不在 ETF 清单里的代码会被忽略
# 默认：沪深300(510300/510310/510330/159919)、上证50(510050)、
#       中证500(510500/159922/512500)、中证1000(512100/159845)、
#       科创50(588000/588080)、创业板(159915)、中证A500(512050/159338)
# FAST_TICK_CODES=510300,510310,510330,159919,510050
# 内存环形缓冲保留时长（秒），决定「最近 N 分钟」秒级视图可回看的范围
FAST_MEMORY_SEC=1800
# 落库批量间隔（毫秒）：秒级点先攒在内存，按批写库
FAST_FLUSH_MS=5000
# 秒级数据保留天数（15 只 × 4 小时 ≈ 21 万行/天）
FAST_RETENTION_DAYS=2
# 秒级请求超时（毫秒）：必须短，否则一轮压一轮
FAST_TIMEOUT_MS=3000

# ---- 日内量能突变预警（VSD）----
# 参数由单日横截面回测得出，详见 reports/volume-surge-backtest.md
SURGE_ALERT_ENABLED=true
# 盘中扫描间隔（毫秒），与分钟 K 线粒度对齐
SURGE_SCAN_INTERVAL_MS=60000
# 每轮盘中刷新的标的数（轮转覆盖；0 表示不主动刷新，只用已有缓存）
SURGE_LIVE_REFRESH_LIMIT=40
# 价格确认模式：graded 分级（默认）/ break 只认区间突破 / strict 无确认即丢弃
# graded 下未获确认的爆量仍会在图上标注（L1，不推送），当日峰值事件提到 L2
SURGE_CONFIRM_MODE=graded
# 价格位移确认阈值（%）：该分钟涨跌幅绝对值达到此值即视为「有方向」
SURGE_MIN_TICK_PCT=0.1
# 极值收盘确认：收盘价即当分钟最高/最低价（单向扫单）也算方向确认
SURGE_EDGE_CONFIRM=true
# 当日成交额峰值加成：整波累计额创当日新高时提升等级
SURGE_PEAK_BOOST=true
# 同波合并间隔（分钟）：相邻异动分钟间隔不超过该值即合并为一处标注
SURGE_MERGE_GAP_BARS=5
# 单分钟成交额下限（元），过滤「10 手变 200 手」这类无资金含义的地量噪声
SURGE_MIN_AMOUNT=3000000
# 盘中入库的最低强度等级：1 弱 / 2 中 / 3 强（弱信号只在分时图标注，不入告警表）
SURGE_MIN_LEVEL=2
# 回放入库的最低强度等级：只留强信号，避免收盘补录淹没告警页
SURGE_BACKFILL_MIN_LEVEL=3
# 事件被视为「实时」的时间窗（秒），超出窗口的历史事件按回放处理
SURGE_LIVE_WINDOW_SEC=600

# ---- 秒级主动买卖攻势（TFI，仅核心池）----
# 判定单位是 15 秒桶的「主动净买入额」，而不是单秒量能倍数：
# 秒级成交稀疏、单笔重尾，单秒倍数没有统计意义。详见 reports/tick-impulse-design.md
TICK_IMPULSE_ENABLED=true
# 扫描间隔（毫秒）：比采集（1 秒）粗一档，避免同一批桶被反复判定
TICK_IMPULSE_SCAN_MS=5000
# 单次判定读取的秒级窗口（秒）
TICK_IMPULSE_WINDOW_SEC=900
# 判定桶宽（秒）
TICK_IMPULSE_BUCKET_SEC=15
# 基线桶数与最少桶数：20 桶 × 15 秒 = 近 5 分钟，不足 6 桶不判定
TICK_IMPULSE_BASELINE_BUCKETS=20
TICK_IMPULSE_MIN_BASELINE=6
# 桶内最少有效秒数：无成交的秒不产生快照，地量桶不参与判定
TICK_IMPULSE_MIN_SAMPLES=3
# 相对门槛：桶主动净买入 / 基线桶成交额中位数
TICK_IMPULSE_NET_RATIO=0.6
# 绝对门槛（元/桶）：低于此值不产生事件，拦住「地量标的刷倍数」
TICK_IMPULSE_MIN_NET=500000
# 净额 / 桶成交额 下限：只认单边主动成交
TICK_IMPULSE_BUY_SHARE=0.2
# 稳健 z 下限（基于前 20 桶净额的 MAD）
TICK_IMPULSE_Z=4
# 连续确认桶数：3 桶 = 连续 45 秒同向；调到 2 会显著增加误报
TICK_IMPULSE_CONFIRM_BUCKETS=3
# 同一波攻势的事件合并间隔（秒）
TICK_IMPULSE_MERGE_GAP_SEC=90
# 是否检测主动卖出攻势
TICK_IMPULSE_DETECT_DRAIN=true
# 桶内价格位移达到此值（%）时强度加一级（价格不作为硬门槛：护盘常在下跌中承接）
TICK_IMPULSE_PRICE_MOVE_PCT=0.12
# 盘中入库的最低强度等级
TICK_IMPULSE_MIN_LEVEL=2
# 事件被视为「实时」的时间窗（秒）
TICK_IMPULSE_LIVE_WINDOW_SEC=300
# 跨标的共振窗口（秒）与最少族数：沪深300/中证500/科创50 同时净买才算共振
TICK_IMPULSE_RESONANCE_WINDOW_SEC=120
TICK_IMPULSE_RESONANCE_MIN_FAMILIES=2

# ---- 安全与可观测 ----
# 允许的跨域来源，逗号分隔；同源访问无需配置
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
LOG_LEVEL=info
